{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1"
  },
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "@swc/jest",
      {
        "jsc": {
          "parser": { "syntax": "typescript", "decorators": true, "dynamicImport": true },
          "transform": { "decoratorMetadata": true },
          "target": "es2023"
        },
        "module": { "type": "commonjs" },
        "sourceMaps": "inline"
      }
    ]
  }
}
