# Application configuration
# NODE_ENV: development | test | staging | production
NODE_ENV=development

# Human-readable name used in logs and Swagger UI
APP_NAME=NestJS SaaS API

# Absolute base URL used in public API file links and other externally returned URLs
APP_BASE_URL=http://localhost:3000

# HTTP listen port inside and outside local Docker
PORT=3000

# Public API routing
API_PREFIX=api

# Authentication. Use a randomly generated value of at least 32 characters outside local development.
# Access tokens default to 15 minutes; sessions use a 14-day absolute lifetime.
AUTH_ACCESS_TOKEN_SECRET=local-only-change-this-access-token-secret
AUTH_TOKEN_ISSUER=nestjs-saas-api
AUTH_TOKEN_AUDIENCE=nestjs-saas-clients
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_VERIFICATION_CODE_TTL_SECONDS=600
AUTH_VERIFICATION_CODE_MAX_ATTEMPTS=5
AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=1800
AUTH_MAX_ACTIVE_SESSIONS=5
AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_TWO_STEP_CODE_TTL_SECONDS=300
AUTH_TWO_STEP_MAX_ATTEMPTS=5
AUTH_RECOVERY_CODE_COUNT=10

# Mail producer and Handlebars branding. Delivery is processed asynchronously from the mail queue.
MAIL_ENABLED=true
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=NestJS SaaS
MAIL_ACTION_BASE_URL=http://localhost:3000
MAIL_SMTP_HOST=mailpit
MAIL_SMTP_PORT=1025
MAIL_SMTP_SECURE=false
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_MAX_RETRIES=5
MAIL_RETRY_DELAY_MS=30000
MAIL_WORKER_CONCURRENCY=5
MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
MAIL_SMTP_SOCKET_TIMEOUT_MS=30000
MAIL_BRANDING_PRIMARY_COLOR=#4F46E5
MAIL_BRANDING_SECONDARY_COLOR=#7C3AED
MAIL_BRANDING_LOGO_URL=
MAIL_BRANDING_COMPANY_NAME=NestJS SaaS
MAIL_BRANDING_SUPPORT_EMAIL=support@example.com

# Team invitations. Tokens are single-use, stored only as hashes, and rotated on resend.
TEAM_INVITATION_BASE_URL=http://localhost:3000/invitations/accept
TEAM_INVITATION_TTL_HOURS=72
TEAM_INVITATION_MAX_SENDS=5
TEAM_INVITATION_RESEND_COOLDOWN_SECONDS=60

# Request localization. English is the only shipped language in 0.2.0.
# The custom header is checked before the standard Accept-Language header.
APP_FALLBACK_LANGUAGE=en
APP_SUPPORTED_LANGUAGES=en
APP_HEADER_LANGUAGE=x-custom-lang

# Browser origins allowed to send credentialed requests. Comma-separated; wildcards are rejected.
CORS_ORIGINS=http://localhost:3000

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Sentry error monitoring and tracing. Disabled means the DSN must remain empty.
# Release should be an immutable image digest, Git commit, or SemVer release identifier.
# Default PII collection is always disabled in code; request bodies, cookies, query strings, and
# sensitive headers are removed before transmission.
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DEBUG=false

# Swagger documentation access: public | basic | disabled
# Staging and production reject public access. Basic passwords require at least 16 characters.
SWAGGER_DOCS_ACCESS=public

# Required only when SWAGGER_DOCS_ACCESS=basic; keep both empty otherwise
SWAGGER_DOCS_USERNAME=
SWAGGER_DOCS_PASSWORD=

# PostgreSQL configuration
DATABASE_HOST=postgres
# Valid TCP port: 1-65535
DATABASE_PORT=5432
DATABASE_NAME=nestjs_saas
DATABASE_USERNAME=nestjs_saas
DATABASE_PASSWORD=local-database-password
# Enable SSL for managed PostgreSQL. Keep certificate verification enabled in managed environments.
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=true
# Connection pool and startup connection timeout
DATABASE_POOL_SIZE=20
DATABASE_CONNECT_TIMEOUT_MS=5000

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=local-redis-password
# Logical Redis database: 0-15
REDIS_DB=0
REDIS_CONNECT_TIMEOUT_MS=5000

# HTTP rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# File storage. New uploads use FILES_WRITE_DRIVER; all providers referenced by stored files must
# remain in FILES_READ_DRIVERS during an online migration.
FILES_WRITE_DRIVER=local
FILES_READ_DRIVERS=local
FILES_LOCAL_ROOT=/app/storage/files
FILES_UPLOAD_EXPIRATION_HOURS=24
FILES_SIGNED_URL_TTL_SECONDS=300
FILES_WORKER_CONCURRENCY=5
FILES_MAX_RETRIES=5
FILES_RETRY_DELAY_MS=30000
FILES_USER_AVATAR_MAX_BYTES=5242880
FILES_USER_AVATAR_MAX_WIDTH=8192
FILES_USER_AVATAR_MAX_HEIGHT=8192
FILES_USER_AVATAR_MAX_PIXELS=25000000

# Required when s3 appears in FILES_READ_DRIVERS. Prefer workload/IAM credentials in managed AWS.
FILES_S3_BUCKET=app-files
FILES_S3_REGION=us-east-1
FILES_S3_ENDPOINT=http://localstack:4566
FILES_S3_FORCE_PATH_STYLE=true
FILES_S3_CDN_URL=
FILES_S3_ACCESS_KEY_ID=test
FILES_S3_SECRET_ACCESS_KEY=test
FILES_S3_SERVER_SIDE_ENCRYPTION=AES256
FILES_S3_KMS_KEY_ID=
