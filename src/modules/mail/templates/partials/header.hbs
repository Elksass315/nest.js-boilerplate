<header style='background:{{branding.primaryColor}};padding:24px 40px;text-align:center'>
  {{#if branding.logoUrl}}
    <img
      src='{{branding.logoUrl}}'
      alt='{{branding.companyName}}'
      style='max-height:48px;max-width:200px'
    />
  {{else}}
    <h1 style='color:#fff;margin:0;font-size:24px'>{{branding.companyName}}</h1>
  {{/if}}
</header>