{
  "name": "nestjs-saas-boilerplate",
  "version": "0.0.0-development",
  "description": "Production-ready single-tenant NestJS SaaS foundation",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/apps/api/main.js",
    "start:worker:mail": "node --enable-source-maps dist/apps/mail-worker/main.js",
    "start:worker:mail:dev": "nest start --entryFile apps/mail-worker/main --watch",
    "start:worker:files": "node --enable-source-maps dist/apps/file-worker/main.js",
    "start:worker:files:dev": "nest start --entryFile apps/file-worker/main --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand",
    "test:tools": "node --test tools/*.test.mjs",
    "arch:check": "node tools/check-architecture.mjs && node tools/check-api-contracts.mjs && depcruise src --config .dependency-cruiser.cjs",
    "i18n:check": "node tools/check-translations.mjs",
    "branch:check": "node tools/check-branch-name.mjs",
    "branch:write-check": "node tools/check-branch-name.mjs --write",
    "docs:check": "node tools/check-documentation.mjs",
    "runtime-images:check": "node tools/check-runtime-images.mjs",
    "deps:check": "knip",
    "deps:duplicates:check": "pnpm dedupe --check",
    "licenses:check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"0BSD;Apache-2.0;BSD-2-Clause;BSD-3-Clause;BlueOak-1.0.0;ISC;MIT;MPL-2.0;Python-2.0;CC0-1.0;Unicode-DFS-2016\"",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch:check && pnpm i18n:check && pnpm docs:check && pnpm runtime-images:check && pnpm deps:check && pnpm deps:duplicates:check && pnpm licenses:check && pnpm audit:prod && pnpm test:cov && pnpm test:tools && pnpm build",
    "validate:change": "node tools/validate-change.mjs",
    "validate:pre-push": "pnpm branch:write-check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch:check && pnpm i18n:check && pnpm docs:check && pnpm runtime-images:check && pnpm test:unit && pnpm test:tools && pnpm build",
    "migration:generate": "node tools/migration.mjs generate",
    "migration:create": "node tools/migration.mjs create",
    "migration:run": "node tools/migration.mjs run",
    "migration:revert": "node tools/migration.mjs revert",
    "migration:show": "node tools/migration.mjs show",
    "migration:validate": "node tools/migration.mjs validate",
    "migration:run:prod": "typeorm -d dist/database/data-source.js migration:run",
    "seed:run": "ts-node -r tsconfig-paths/register src/database/seeds/seed-runner.ts run",
    "seed:show": "ts-node -r tsconfig-paths/register src/database/seeds/seed-runner.ts show",
    "auth:bootstrap-admin": "ts-node -r tsconfig-paths/register src/database/bootstrap-admin.ts",
    "seed:run:prod": "node dist/database/seeds/seed-runner.js run",
    "files:migration:status": "ts-node -r tsconfig-paths/register src/apps/files-migration/main.ts status",
    "files:migrate": "ts-node -r tsconfig-paths/register src/apps/files-migration/main.ts migrate",
    "scaffold:feature": "node tools/scaffold-feature.mjs",
    "docker:up": "node tools/docker.mjs up",
    "docker:down": "node tools/docker.mjs down",
    "docker:restart": "node tools/docker.mjs restart",
    "docker:logs": "node tools/docker.mjs logs",
    "docker:ps": "node tools/docker.mjs ps",
    "docker:config": "node tools/docker.mjs config",
    "docker:reset": "node tools/docker.mjs reset",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1109.0",
    "@aws-sdk/s3-request-presigner": "3.1109.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@sentry/nestjs": "10.70.0",
    "@tus/file-store": "2.1.1",
    "@tus/s3-store": "2.0.5",
    "@tus/server": "2.4.3",
    "argon2": "0.45.1",
    "bullmq": "6.0.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "handlebars": "4.7.9",
    "helmet": "8.3.0",
    "ioredis": "5.10.0",
    "joi": "18.2.3",
    "jose": "5.10.0",
    "nestjs-i18n": "10.8.5",
    "nestjs-pino": "4.6.1",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "6.0.3",
    "dependency-cruiser": "18.1.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "knip": "6.32.0",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
